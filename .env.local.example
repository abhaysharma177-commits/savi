# ─────────────────────────────────────────────────────────────────────────────
# Second Opinion — environment configuration
# Copy this file to `.env.local` and fill in the values.  Only ANTHROPIC_API_KEY
# is required; everything else has a safe default or an in-memory fallback.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — your Anthropic API key (https://console.anthropic.com/).
ANTHROPIC_API_KEY=sk-ant-...

# OPTIONAL — model selection.  Defaults to claude-opus-4-8 everywhere.
# Structured outputs require a model that supports them (Opus 4.8 / Sonnet 5 /
# Haiku 4.5 / Fable 5).  The app degrades gracefully to JSON extraction if a
# model without structured-output support is used.
SECOND_OPINION_MODEL=claude-opus-4-8
# Fine-grained overrides (fall back to SECOND_OPINION_MODEL when unset):
# SECOND_OPINION_TRIAGE_MODEL=claude-opus-4-8
# SECOND_OPINION_SPECIALIST_MODEL=claude-opus-4-8
# SECOND_OPINION_SYNTHESIS_MODEL=claude-opus-4-8

# OPTIONAL — reasoning effort per stage (low | medium | high | xhigh | max).
# SECOND_OPINION_SPECIALIST_EFFORT=medium
# SECOND_OPINION_SYNTHESIS_EFFORT=high

# OPTIONAL — Supabase persistence.  If these are unset the app uses an in-memory
# store and still runs end-to-end (ideal for local demos).  Set all three to
# persist cases, reviews and consensus to Postgres.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
